{
  "version": 2,
  "functions": {
    "api/pdf/render.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/pdf/document.ts": {
      "maxDuration": 60,
      "includeFiles": "api/pdf/assets/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www\\.freeminiworkshop\\.com" }],
      "destination": "https://freeminiworkshop.com/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "freeminiworkshop\\.com" }],
      "destination": "/api/hub/render"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "host", "value": "([^.]+)\\.freeminiworkshop\\.com" }],
      "destination": "/api/funnels/render?page=privacy"
    },
    {
      "source": "/terms",
      "has": [{ "type": "host", "value": "([^.]+)\\.freeminiworkshop\\.com" }],
      "destination": "/api/funnels/render?page=terms"
    },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "([^.]+)\\.freeminiworkshop\\.com" }],
      "destination": "/api/funnels/render"
    }
  ]
}
